# ── Baza danych (MySQL 8) ────────────────────────────────────────────────────
DATABASE_URL="mysql://varify:varify@localhost:3306/varify_db"

# ── Redis (kolejki BullMQ + rozproszone blokady cron/jobów) ───────────────────
REDIS_URL="redis://localhost:6379"

# ── Aplikacja ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Dozwolone originy frontendu (CORS + Socket.IO); wiele po przecinku. Używane też w linkach push/Stripe.
FRONTEND_URL="http://localhost:3000"
# Limit żądań na minutę na IP (domyślnie 240). Auth/AI/Stripe mają własne, ostrzejsze limity.
THROTTLE_LIMIT=240

# ── JWT (WYMAGANE w produkcji, min. 16 znaków) ────────────────────────────────
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# ── SportAPI v7 (RapidAPI) ────────────────────────────────────────────────────
SPORT_API_KEY=""
SPORT_API_HOST="sportapi7.p.rapidapi.com"
# opcjonalne: własny adres bazowy (np. mock w testach), timeout i liczba ponowień (backoff + Retry-After)
# SPORT_API_BASE_URL="https://sportapi7.p.rapidapi.com/api/v1"
# SPORT_API_TIMEOUT_MS=10000
# SPORT_API_MAX_RETRIES=3

# ── Groq (AI Analyst, plan PREMIUM) ───────────────────────────────────────────
GROQ_API_KEY=""
# GROQ_MODEL="llama-3.1-8b-instant"

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
# whsec_... z `stripe listen` / panelu; webhook: POST {API}/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PLUS=""
STRIPE_PRICE_ID_PREMIUM=""

# ── Web Push (VAPID) — opcjonalne; bez tego działają tylko powiadomienia WebSocket ──
# Generowanie:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Powiadomienia także dla lig spoza listy TOP (domyślnie wyłączone — oszczędza limit API)
# PUSH_ALL_LEAGUES=true

# ── Testy integracyjne (opcjonalne; baza z zastosowanymi migracjami) ───────────
# TEST_DATABASE_URL="mysql://varify:varify@127.0.0.1:3306/varify_test"
